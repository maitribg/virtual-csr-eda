{
  "rubric_name": "CSR Conflict-Resolution Quality Rubric (IRP + Communication Skills)",
  "scoring_scale": "1-5 (1 = poor, 5 = excellent)",

  "dimensions": {

    "interests_based_reasoning": {
      "description": "Measures how much the CSR uses collaborative, mutual-goal, problem-solving strategies. This is the ONLY positively encouraged IRP behavior.",
      "interpretation": "Higher score = better.",
      "anchors": {
        "1": "No attempt to understand customer needs; no cooperative framing; ignores goals.",
        "2": "Minimal interests-based reasoning; superficial or inconsistent.",
        "3": "Some interest-based framing but not sustained or fully aligned with customer needs.",
        "4": "Mostly focuses on mutual goals, shared problem-solving, and collaboration.",
        "5": "Strongly and consistently interest-based; frames the situation around mutual benefit and cooperative resolution."
      }
    },

    "rights_based_reasoning": {
      "description": "Measures how much the CSR relies on rules, policies, fairness claims, or procedural constraints. This behavior is discouraged.",
      "interpretation": "Higher score = LESS rights-based reasoning (good). Lower score = rule-heavy or rigid (bad).",
      "anchors": {
        "1": "Heavy reliance on rules or policy; uses rules to block progress or dismiss customer needs.",
        "2": "Frequent reference to rules/policies even when unnecessary; rigid tone.",
        "3": "Moderate use of rules; somewhat neutral but not aligned with interest-based goals.",
        "4": "Occasional rule mention, softened with empathy or alternatives.",
        "5": "Avoids rule-based reasoning almost entirely; focuses instead on flexible, interest-based solutions."
      }
    },

    "power_based_reasoning": {
      "description": "Measures how much the CSR uses pressure, authority, coercion, or control tactics (heavily discouraged).",
      "interpretation": "Higher score = LESS power-based reasoning (good). Lower score = controlling/pressuring behavior (bad).",
      "anchors": {
        "1": "Uses coercion, pressure, threats, or manipulative tone; highly power-driven.",
        "2": "Occasional pressuring or dominance; mildly coercive.",
        "3": "Neutral tone but includes subtle control or pressure.",
        "4": "Rarely uses power; mostly respectful and non-coercive.",
        "5": "Completely avoids power moves; fully autonomy-supportive and non-pressuring."
      }
    },

    "attentiveness": {
      "description": "Measures whether the CSR verbally demonstrates active listening and interest (e.g., backchannels, supportive signals).",
      "interpretation": "Higher score = better cognitive support and customer engagement.",
      "anchors": {
        "1": "Shows no listening cues; interrupts or ignores customer statements.",
        "2": "Inconsistent listening; occasionally acknowledges but often disengaged.",
        "3": "Acceptable attentiveness; basic acknowledgments present but limited.",
        "4": "Consistently attentive with meaningful verbal backchannels; clearly engaged.",
        "5": "Exceptionally attentive; supports customer sharing and maintains strong presence."
      }
    },

    "perceptiveness": {
      "description": "Measures understanding, interpretation, and empathy (rephrasing, emotional acknowledgment, clarifying).",
      "interpretation": "Higher score = better understanding and emotional alignment.",
      "anchors": {
        "1": "No attempt to understand customer meaning or emotion; responds inappropriately.",
        "2": "Limited perceptiveness; superficial acknowledgment without depth.",
        "3": "Adequate understanding; occasionally mirrors emotion or clarifies.",
        "4": "Strong perceptiveness; regularly rephrases, clarifies, and shows emotional insight.",
        "5": "Highly perceptive; deeply understands customer meaning and emotional state, enabling strong value creation."
      }
    },

    "responsiveness": {
      "description": "Measures whether the CSR demonstrates mutual understanding through clear restatements, validations, and logical follow-through.",
      "interpretation": "Higher score = better alignment and decision support.",
      "anchors": {
        "1": "Responses do not match customer concerns; ignores issues.",
        "2": "Partially responsive; may address only fragments of the customer's message.",
        "3": "Generally responsive but not fully aligned; some gaps in understanding.",
        "4": "Consistently responsive; restates, clarifies, and confirms shared understanding.",
        "5": "Highly responsive; ensures complete alignment, helps customer make decisions, and verifies mutual understanding."
      }
    }
  }
}
