{
  "rubric_name": "Customer Service Quality Rubric",
  "scale_definition": {
    "1": "Very Poor — fails the criterion, harmful or counterproductive.",
    "2": "Poor — attempts the criterion but with major issues.",
    "3": "Adequate — meets the basic expectation with noticeable gaps.",
    "4": "Good — above average, minor improvements needed.",
    "5": "Excellent — fully meets or exceeds expectations, highly effective."
  },
  "categories": [
    {
      "section": "IRP Conflict-Resolution Criteria",
      "criteria": [
        {
          "name": "Interests-Based Reasoning",
          "definition": "Focuses on mutual goals, customer needs, collaboration, and problem-solving.",
          "score_anchors": {
            "1": "Shows no interest in customer needs; pushes generic solutions.",
            "3": "Acknowledges interests but inconsistently ties them to solutions.",
            "5": "Fully aligns with customer goals, asks clarifying questions, proposes collaborative solutions."
          }
        },
        {
          "name": "Rights-Based Reasoning",
          "definition": "References rules or fairness appropriately, without rigidity or deflection.",
          "score_anchors": {
            "1": "Hides behind policies; uses rules to shut down dialogue.",
            "3": "References policies but lacks empathy or flexibility.",
            "5": "Uses rules respectfully, balances fairness with customer needs."
          }
        },
        {
          "name": "Power-Based Reasoning",
          "definition": "Avoids coercion, threats, or authoritative language.",
          "score_anchors": {
            "1": "Uses coercive or threatening tone; asserts power over customer.",
            "3": "Tone is occasionally controlling or dismissive without being overtly coercive.",
            "5": "Fully avoids coercion, adopts non-threatening, collaborative language."
          }
        }
      ]
    },
    {
      "section": "Core Communication Competencies",
      "criteria": [
        {
          "name": "Attentiveness",
          "definition": "Shows active listening using acknowledgments and engaged responses.",
          "score_anchors": {
            "1": "Ignores customer statements; no acknowledgment or engagement.",
            "3": "Acknowledges some points but inconsistently shows active listening.",
            "5": "Fully attentive; consistently acknowledges details with verbal encouragers."
          }
        },
        {
          "name": "Perceptiveness",
          "definition": "Accurately interprets messages and emotions; asks clarifying questions.",
          "score_anchors": {
            "1": "Misinterprets or dismisses concerns; no emotional awareness.",
            "3": "Understands basic facts but misses emotional cues or deeper meaning.",
            "5": "Fully understands explicit and implicit messages; recognizes emotions; clarifies thoughtfully."
          }
        },
        {
          "name": "Responsiveness",
          "definition": "Provides clear, complete, and mutually understood answers.",
          "score_anchors": {
            "1": "Answers are irrelevant, incomplete, or unclear.",
            "3": "Addresses the question but with gaps or vague explanations.",
            "5": "Fully answers the issue, confirms understanding, and ensures clarity."
          }
        }
      ]
    },
    {
      "section": "Additional Criteria",
      "criteria": [
        {
          "name": "Empathy & Emotional Support",
          "definition": "Validates emotions and maintains warmth.",
          "score_anchors": {
            "1": "Cold, dismissive, or invalidating.",
            "3": "Acknowledges emotion minimally or mechanically.",
            "5": "Warm, validating, emotionally supportive without overstepping."
          }
        },
        {
          "name": "Clarity & Readability",
          "definition": "Message is concise, structured, and easy to understand.",
          "score_anchors": {
            "1": "Confusing, poorly structured, hard to follow.",
            "3": "Understandable but somewhat wordy or unorganized.",
            "5": "Crystal-clear, logically structured, simple language."
          }
        },
        {
          "name": "Solution Quality & Usefulness",
          "definition": "Provides accurate, helpful, actionable next steps.",
          "score_anchors": {
            "1": "Incorrect, misleading, or unhelpful solution.",
            "3": "Partially helpful but missing detail or accuracy.",
            "5": "Highly effective, accurate, actionable solution tailored to customer."
          }
        },
        {
          "name": "Professionalism & Politeness",
          "definition": "Maintains a respectful tone throughout.",
          "score_anchors": {
            "1": "Unprofessional, rude, or inappropriate.",
            "3": "Mostly polite but inconsistently professional.",
            "5": "Consistently professional, courteous, and respectful."
          }
        },
        {
          "name": "Efficiency",
          "definition": "Communicates succinctly without losing information.",
          "score_anchors": {
            "1": "Verbose or cluttered; wastes customer time.",
            "3": "Some unnecessary wording but generally efficient.",
            "5": "Direct, concise, no wasted text."
          }
        }
      ]
    }
  ]
}
